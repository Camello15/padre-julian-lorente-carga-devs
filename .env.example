# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# Mientras no haya acceso a las APIs reales, deja USAR_MOCKS=true.

# --- Backend ---
PORT=3000
FRONTEND_URL=http://localhost:5173
USAR_MOCKS=true
# Para probar el RNF-01: nombre de una fuente que fallará a propósito (redmine, gitlab, glpi o rocketchat).
MOCK_FALLA_FUENTE=

# --- Sincronización (RNF-01) ---
SYNC_CRON=*/15 * * * *
SYNC_REINTENTOS=3
SYNC_ESPERA_REINTENTO_MS=2000

# --- Umbral y avance (CU-08, CU-10) ---
UMBRAL_MAX_PETICIONES=6
# Opcional. Porcentaje de avance por etapa; propuesta del equipo pendiente de validar con la cooperativa.
# Ejemplo: {"ANALISIS":10,"DESARROLLO":40,"CERTIFICACION":70,"DESPLIEGUE":90,"ESTABILIZACION":100}
AVANCE_POR_ETAPA=

# --- SSO de la cooperativa (CU-01) ---
# mock = SSO simulado. El protocolo real (OIDC, SAML, CAS…) está pendiente de confirmar con la cooperativa.
SSO_MODO=mock
SSO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DURACION_SESION_MIN=480

# --- Fuentes ---
REDMINE_URL=
REDMINE_API_KEY=
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_IDS=
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
ROCKETCHAT_URL=
ROCKETCHAT_USER_ID=
ROCKETCHAT_TOKEN=
# Canales o grupos desde los que leer mensajes, separados por comas.
ROCKETCHAT_CANALES_LECTURA=
# Canal de destino exclusivo para las alertas salientes.
ROCKETCHAT_CANAL_ALERTAS=#ti-alertas

# --- Base de datos (docker-compose) ---
POSTGRES_DB=carga_devs
POSTGRES_USER=carga_devs
POSTGRES_PASSWORD=
DATABASE_URL=
