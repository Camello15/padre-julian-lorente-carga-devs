@startuml
!include estilo.iuml
left to right direction
title Diagrama de casos de uso · Dashboard de carga de desarrolladores (COAC Padre Julián Lorente)

package "Actores principales" {
  actor "PMO" as PMO
  actor "Técnico" as TEC
  actor "Administrativo" as ADV
  actor "Administrador TI" as ATI
  actor "Usuario de la\ncooperativa" as USR
  actor "Programador de tareas\n(cron cada 15 min)" as CRON <<sistema>>
}

rectangle "Sistema: Dashboard de carga de desarrolladores" {
  usecase "CU-03\nConsultar dashboard\nde carga y avance" as CU03
  usecase "CU-02\nFiltrar información" as CU02
  usecase "CU-01\nIniciar sesión con SSO" as CU01
  usecase "CU-04\nExportar reporte\n«pendiente»" as CU04 #FFF4E6
  usecase "CU-10\nConfigurar umbral" as CU10
  usecase "CU-11\nRevisar registros\nno reconocidos" as CU11
  usecase "CU-05\nSincronizar fuentes" as CU05
  usecase "CU-06\nRegistrar fallo\nde fuente" as CU06
  usecase "CU-07\nCruzar datos\npor código" as CU07
  usecase "CU-08\nCalcular carga\ny avance" as CU08
  usecase "CU-09\nEnviar alerta" as CU09
}

package "Actores secundarios" {
  actor "SSO de la\ncooperativa" as SSO <<sistema externo>>
  actor "RedMine" as RM <<sistema externo>>
  actor "GitLab" as GL <<sistema externo>>
  actor "GLPI" as GP <<sistema externo>>
  actor "Rocket Chat" as RC <<sistema externo>>
}

' Generalización: los 4 roles son usuarios de la cooperativa
USR <|-- PMO
USR <|-- TEC
USR <|-- ADV
USR <|-- ATI

' Asociaciones de actores principales
USR --> CU03
PMO --> CU04
ATI --> CU10
ATI --> CU11
CRON --> CU05

' Relaciones entre casos de uso
CU03 ..> CU02 : <<include>>
CU03 ..> CU01 : <<include>>
CU02 ..> CU01 : <<include>>
CU04 ..> CU01 : <<include>>
CU04 ..> CU03 : <<extend>>
CU05 ..> CU07 : <<include>>
CU05 ..> CU08 : <<include>>
CU06 ..> CU05 : <<extend>>\nfalla tras 3 intentos
CU09 ..> CU08 : <<extend>>\ncarga > umbral

' Asociaciones con actores secundarios
CU01 --> SSO
CU05 --> RM
CU05 --> GL
CU05 --> GP
CU05 --> RC
CU09 --> RC

legend right
  <b>Actores principales</b>: inician los casos de uso.
  Los 4 roles heredan de "Usuario de la cooperativa"
  (todos pueden consultar el dashboard, CU-03).
  <b>Actores secundarios</b>: sistemas externos que el sistema usa.
  CU-04 en naranja = pendiente.
endlegend
@enduml
