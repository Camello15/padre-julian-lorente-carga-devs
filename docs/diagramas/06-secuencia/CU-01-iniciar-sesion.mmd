sequenceDiagram
    title CU-01 Iniciar sesión con SSO
    autonumber
    actor U as Usuario de la cooperativa
    participant L as Login.jsx / App.jsx
    participant A as api.js
    participant R as rutas/auth.js
    participant S as ServicioSesiones
    participant RO as roles.js
    participant SSO as SSO de la cooperativa

    U->>L: Elige rol de prueba y pulsa "Ingresar con SSO de la cooperativa"
    L->>A: iniciarSesion(rol)
    A->>R: POST /api/auth/login {rol}
    alt SSO_MODO = mock (prototipo)
        R->>S: iniciarSesionMock(rol)
        S->>RO: obtenerRol(clave)
        RO-->>S: Rol {clave, permisos, soloPropios}
        S-->>R: Sesion {token, inicio, expira = inicio + 480 min, usuario}
        R-->>A: 201 {token, expira, usuario}
        A-->>L: sesión
        L-->>U: Guarda la sesión en sessionStorage y muestra Dashboard.jsx
    else rol inválido
        R-->>A: 400 "Elige un rol de prueba válido"
        A-->>L: error
        L-->>U: Muestra el mensaje de error
    else SSO real «pendiente»
        R--)SSO: Redirigir y validar token (OIDC/SAML por confirmar)
        R-->>A: 501 No implementado
    end

    opt Cerrar sesión
        U->>L: Pulsa "Cerrar sesión"
        L->>A: cerrarSesion(token)
        A->>R: POST /api/auth/logout
        R->>S: cerrarSesion(token)
        R-->>A: 204
        L-->>U: Vuelve a Login.jsx
    end
