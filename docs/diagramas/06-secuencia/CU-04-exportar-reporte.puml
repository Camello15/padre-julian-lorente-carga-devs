@startuml
!include estilo-secuencia.iuml
title CU-04 Exportar reporte «pendiente, Sprint 4»
actor "PMO" as P
participant "Dashboard.jsx" as V <<vista>>
boundary "api.js" as B <<borde>>
control "requierePermiso\n('exportar')" as M <<controlador>>
control "rutas/reportes.js\n(pendiente)" as R <<controlador>>
control "filtro.js" as FI <<controlador>>
entity "AlmacenMemoria" as AM <<entidad>>
entity "Reporte\n(pendiente)" as RE <<entidad>>

note over P, RE : Extiende CU-03. Solo el rol PMO tiene el permiso exportar.
P -> V : Pulsa "Exportar"
V --> P : HOY: "La exportación a Excel y PDF llega en el Sprint 4."
group Diseño propuesto (pendiente)
  V -> B : pedir("/reportes?formato=xlsx|pdf&" + filtros)
  B -> M : GET /api/reportes
  alt rol sin permiso exportar
    M --> B : 403
    B --> V : error
  else PMO
    M -> R : req.usuario
    R -> FI : crearFiltro(query), filtrarPeticiones(...)
    FI -> AM : peticiones
    AM --> FI : datos
    FI --> R : peticiones filtradas
    R -> RE ** : new Reporte(formato, generadoEn, fechaUltimaSync)
    R -> RE : generarExcel() / generarPdf()
    RE --> R : archivo
    R --> B : 200 archivo .xlsx o .pdf
    B --> V : descarga
    V --> P : El navegador descarga el reporte
  end
end
@enduml
